# Pick a provider: 'gemini' (free) or 'openai' (paid)
LLM_PROVIDER=gemini

# --- Gemini (free) ---  get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_VISION_MODEL=gemini-1.5-flash

# --- OpenAI (paid) ---  optional; leave blank if using Gemini
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o

# --- App ---
DATABASE_URL=sqlite:///./careflow.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
